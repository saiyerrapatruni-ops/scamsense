# ScamSense Environment Variables
# -------------------------------------------------------------
# Choose ONE of the following options:

# Option A: Free Cloud PostgreSQL via Supabase (Recommended)
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> Database -> Connection String (URI / Nodejs)
# 3. Paste the connection string below:
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Option B: Free Cloud PostgreSQL via Neon
# 1. Create a free project at https://neon.tech
# 2. Copy the Connection Details URI and paste below:
# DATABASE_URL=postgresql://neondb_owner:yourpassword@ep-cool-frost-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option C: Local PostgreSQL (If installed on your machine)
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/scamsense

PORT=5000
